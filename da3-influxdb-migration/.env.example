# InfluxDB 2.x Connection Settings (Isolated DA3 Component)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=smarthome_org
INFLUXDB_BUCKET=sensor_telemetry
INFLUXDB_PORT=8086

# Authentication Credentials
# For local development with Docker Compose, you can generate a token or use a secure placeholder:
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=SmartHomeAdminPass123!
INFLUXDB_TOKEN=da3_super_secret_sensor_telemetry_token_123456789
