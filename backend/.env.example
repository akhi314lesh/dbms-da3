# Oracle Database Credentials & Connection
DB_PASSWORD=your_local_oracle_password_here
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
SPRING_DATASOURCE_USERNAME=SMART_HOME

# Google Cloud / Firebase Admin SDK Service Account
# Absolute or relative path to your downloaded Firebase service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/smart-home-service-account.json

# Admin Bootstrap Email (Users authenticating with this email are assigned ADMIN role)
ADMIN_GOOGLE_EMAIL=admin@example.com

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
